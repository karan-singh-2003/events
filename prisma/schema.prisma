generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  name         String?
  email        String?      @unique
  password     String
  createdAt    DateTime     @default(now())
  isAdmin      Boolean      @default(false)
  universityId String       @unique
  Members      Members[]
  Permission   Permission[]
  Roles        Roles[]
  Workspaces   Workspaces[]
  event       Event[]
}

model Workspaces {
  id              String           @id @default(uuid())
  name            String
  ownerId         String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isOnboarded     Boolean          @default(false)
  members         Members[]
  permissions     Permission[]
  rolePermissions RolePermission[]
  roles           Roles[]
  user            User             @relation(fields: [ownerId], references: [id])
  event         Event[]
}

model Members {
  id          String     @id @default(uuid())
  userId      String
  workspaceId String
  createdAt   DateTime   @default(now())
  rolesId     String?
  Roles       Roles?     @relation("RoleOnMember", fields: [rolesId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
  workspace   Workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Roles {
  id              String           @id @default(uuid())
  name            String
  workspaceId     String
  createdAt       DateTime         @default(now())
  userId          String
  members         Members[]        @relation("RoleOnMember")
  rolePermissions RolePermission[]
  user            User             @relation(fields: [userId], references: [id])
  workspace       Workspaces       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Permission {
  id              String           @id @default(uuid())
  title           String
  type            PermissionType
  workspaceId     String
  createdAt       DateTime         @default(now())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  workspace       Workspaces       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String
  permissionId String
  workspaceId  String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Roles      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workspace    Workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum PermissionType {
  WORKSPACE
  EVENT
  TASK
}

// Enums for better type safety and cleaner logic
enum ProjectStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Event {
  id          String          @id @default(uuid())
  name        String
  description String
  status      ProjectStatus   @default(TODO)
  priority    ProjectPriority @default(MEDIUM)
  deadline    DateTime?

  workspaceId String
  userId      String

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace   Workspaces      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@map("Event") /// 👈 Map this Prisma model to the existing "Project" table in PostgreSQL
}
